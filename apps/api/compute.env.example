# Optional private local settings: copy to apps/api/.env.compute.
# Compose fixes DATABASE_URL to the local development DB; use compose.forecast.yaml
# for the separately reviewed Neon path. Nothing here migrates or seeds on startup.
# Leave blank for the infrastructure-only public queue. After deliberate demo
# loading, set this to that loader's dedicated ppor_demo_* schema
# (pp45_demo_* is the forecast-only alternative).
PP_DATABASE_SCHEMA=
# Fill these privately only after choosing/seeding the synthetic demo organization.
PP_PRESENTER_USERNAME=
PP_PRESENTER_PASSWORD_HASH=
PP_PRESENTER_ORGANIZATION_ID=
PP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000
PP_TRUSTED_PROXY_TOKEN=
# This exception is for loopback HTTP only; Fly requires true.
PP_COOKIE_SECURE=false

# Leave disabled until the pinned cache and actual worker have been verified.
# Copy revision from /cache/model-pin.json created by the explicit model tools.
PP_CHRONOS_ENABLED=0
PP_CHRONOS_REVISION=
PP_CHRONOS_MODEL_CACHE=/cache/huggingface/hub
