# Local development only. Copy to apps/api/.env and fill in credentials from compose.yaml.
# This URL is for processes running on the Windows host, not Neon.
# Compose supplies its own container URL using postgres:5432.
# Load explicitly with uvicorn --env-file .env; startup never migrates or seeds.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@127.0.0.1:55432/pantrypulse_dev
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
FORECAST_PROVIDER=seasonal-naive
FORECAST_MODEL_ID=amazon/chronos-2
FORECAST_DEVICE=cpu
SOLVER_TIME_LIMIT_SECONDS=5
DEMO_FIXED_DATE=2026-10-24

# PP-45: use the NEW selected Neon URLs in your private file, never old commented URLs.
# Direct connection is required only for deliberate migration/demo-loader commands.
DATABASE_URL_UNPOOLED=
PP_DATABASE_SCHEMA=
PP_PRESENTER_USERNAME=
PP_PRESENTER_PASSWORD_HASH=
PP_PRESENTER_ORGANIZATION_ID=
PP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000
PP_TRUSTED_PROXY_TOKEN=
# Only local HTTP permits this; deployed cookies must be secure.
PP_COOKIE_SECURE=false

# Opt-in experimental Chronos worker capability. Never follow a moving model ref.
# Copy the full revision from the explicitly prepared model-pin.json.
PP_CHRONOS_ENABLED=0
PP_CHRONOS_REVISION=
# Trusted absolute path on the worker; API need not mount the model volume.
PP_CHRONOS_MODEL_CACHE=/cache/huggingface/hub

