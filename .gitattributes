# Files that run inside Linux containers must keep LF endings on a Windows checkout.
*.sh text eol=lf
Dockerfile* text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Template drift tests compare bytes; keep LF on a Windows checkout too.
data/templates/**/*.csv text eol=lf
